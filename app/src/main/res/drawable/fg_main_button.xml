<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:type="linear" android:angle="90"
                        android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                </shape>
            </item>
            <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="#55FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
