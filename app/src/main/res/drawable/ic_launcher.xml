<?xml version="1.0" encoding="utf-8"?>
<!-- Simple launcher icon: red record dot on dark circle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF1E2A38" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:bottom="30dp" android:left="30dp" android:right="30dp" android:top="30dp">
        <shape android:shape="oval">
            <solid android:color="#FFE53935" />
        </shape>
    </item>
</layer-list>
